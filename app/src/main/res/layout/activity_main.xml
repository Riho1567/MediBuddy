<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado con botón salir -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTituloApp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MediBuddy"
                    android:textColor="#0D47A1"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pastillero Conectado • Compartimento 1"
                    android:textColor="#546E7A"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salir"
                android:textColor="#C62828"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Barra de 2 Botones de Navegación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrRegistro"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#E3F2FD"
                android:text="+ Registrar Toma"
                android:textColor="#0D47A1"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrHistorial"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#E3F2FD"
                android:text="Ver Historial"
                android:textColor="#0D47A1"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Tarjeta de la Toma Actual -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeColor="#1976D2"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvEstadoAlerta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#E3F2FD"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="PRÓXIMA TOMA PROGRAMADA"
                    android:textColor="#1565C0"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNombreMedicamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Losartán 50mg"
                    android:textColor="#102027"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDosis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Dosis: 1 Tableta"
                    android:textColor="#37474F"
                    android:textSize="18sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#E0E6ED" />

                <TextView
                    android:id="@+id/tvHoraProgramada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hora: 08:00 AM"
                    android:textColor="#263238"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTiempoEspera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tiempo de espera: 5 minutos"
                    android:textColor="#C62828"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón gigante Confirmar Toma -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarToma"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#0D47A1"
            android:text="YA TOMÉ EL MEDICAMENTO"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

        <!-- Botón Posponer -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPosponerToma"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:strokeColor="#1976D2"
            android:text="Posponer (5 minutos)"
            android:textColor="#1565C0"
            android:textSize="15sp"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>